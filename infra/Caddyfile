# Единый Caddyfile для dev и прода.
# /api, /socket.io, /uploads → Nest (api:3000), всё прочее → Next (web:3001).
# Один origin ⇒ кука relay_pass общая, WebRTC получает secure-context (getUserMedia).
#
# TLS определяется именем хоста автоматически:
#   localhost  → внутренний CA Caddy (self-signed, доверенный в системе)
#   реальный домен → Let's Encrypt (ACME, сертификат берётся автоматически)
#   голый публичный IP → тоже Let's Encrypt, но нужен явный профиль shortlived;
#     его задаёт tls-mode.caddy (см. import ниже), который пишет install.sh
#
# Домен задаётся через переменную окружения DOMAIN (прод-compose передаёт её).
# В dev-compose DOMAIN не задан → {$DOMAIN:localhost} → localhost.

# При заходе по голому IP (телефон → https://192.168.x.x) браузер НЕ шлёт SNI,
# и Caddy без подсказки не знает, какой сертификат отдать → handshake падает.
# default_sni говорит, какой серт показывать по умолчанию.
{
	default_sni {$DOMAIN:localhost}
}

{$DOMAIN:localhost} {
	# TLS обычно не задаём явно: Caddy сам выбирает по имени хоста — localhost
	# получает внутренний CA (self-signed), реальный домен — сертификат Let's
	# Encrypt. Форсить `tls internal` нельзя: на проде это ломает доверенный HTTPS.
	#
	# Исключение — сертификат на голый IP: там нужен явный issuer с профилем
	# shortlived, и он приезжает отдельным файлом. Шаблон (`tls-*.caddy`, а не
	# имя файла) выбран сознательно: если файла нет вовсе, import молча ничего не
	# делает, и Caddyfile остаётся рабочим сам по себе.
	import tls-*.caddy

	@backend path /api/* /socket.io/* /uploads/*
	handle @backend {
		# reverse_proxy сам выполняет апгрейд WebSocket для /socket.io.
		reverse_proxy api:3000
	}

	# Сигналинг медиасервера (профиль sfu). Отдельный путь, а не namespace
	# socket.io: namespace передаётся уже внутри соединения, прокси его не видит.
	# Само медиа сюда не идёт — оно летит по UDP/TCP прямо в медиасервер.
	# Апстрим приходит переменной: в прод-compose sfu живёт в host-сети и
	# доступен через шлюз хоста; дефолт sfu:3100 — для dev-compose (bridge).
	# Профиль выключен ⇒ апстрим не поднят, и запрос сюда честно вернёт 502.
	@sfu path /sfu/*
	handle @sfu {
		reverse_proxy {$SFU_UPSTREAM:sfu:3100}
	}

	handle {
		reverse_proxy web:3001
	}
}
