# Режим «сертификат на голый IP». Ставится на место tls-mode.caddy, когда домена
# нет, а публичный адрес — маршрутизируемый: install.sh выбирает этот файл при
# установке, `relay update` — по RELAY_TLS_MODE=ip в .env.
#
# Отдельным файлом, а не heredoc'ом внутри инсталлятора, ровно по причине B7:
# сгенерированное на машине пользователя не обновляется никогда. Профиль ACME —
# то, что Let's Encrypt меняет не спрашивая нас (а он уже менялся: выдача на
# IP-адреса появилась только 15.01.2026), и починка этого блока обязана доезжать
# тем же `relay update`, что и всё остальное.
tls {
	issuer acme {
		profile shortlived
	}
	issuer internal
}
