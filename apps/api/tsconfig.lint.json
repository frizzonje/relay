{
  // Тот же проект, но с тестами — для `typecheck` и линта со знанием типов.
  // Сборке они не нужны (иначе уедут в dist), а проверке — обязательно: тест
  // вне проверки типов гниёт молча, проверяя то, чего в коде уже нет. Забытый
  // `await` у асинхронного обработчика тоже живёт именно в тестах.
  "extends": "./tsconfig.json",
  "include": ["src/**/*"],
  "exclude": []
}
