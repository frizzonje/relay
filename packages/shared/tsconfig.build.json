{
  // Сборка для потребителей на CommonJS — api и sfu (Nest под tsc). Web берёт
  // исходник напрямую (`transpilePackages` в next.config.mjs), ему dist не нужен.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "Node",
    "outDir": "./dist",
    "declaration": true,
    "isolatedModules": false
  },
  "include": ["src/**/*"],
  "exclude": ["**/*.test.ts"]
}
