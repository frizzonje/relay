{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "lint": {},
    "test": {
      "dependsOn": ["^build"]
    },
    // Единственная задача, которая читает файлы за пределами своего пакета:
    // контрактный тест сверяет константы @relay/shared с их копией в исходниках
    // api (api намеренно не импортирует этот пакет). Хэш задачи по умолчанию
    // видит только сам пакет — то есть правка в apps/api оставляла в силе
    // ЗЕЛЁНЫЙ результат из кэша. Так и вышло: разбор тел переехал в
    // gateway/protocol.ts (12d2141), тест сломался — и продолжал отвечать
    // «passed» из кэша, пока чужая правка не сбила хэш.
    "@relay/shared#test": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", "../../apps/api/src/**"]
    },
    // tsconfig веба включает `.next/types/**/*.ts` — типы маршрутов, которые
    // пишет сам `next build`. То есть typecheck читает выход соседней задачи,
    // а объявлял зависимость только от `^build` (пакеты выше по графу). Своей
    // сборки среди них нет, так что turbo честно запускал обе разом — и на
    // чистой машине tsc падал с TS6053 на файлах, которых ещё не существует.
    // Локально этого не видно: `.next` остаётся с прошлого раза.
    "@relay/web#typecheck": {
      "dependsOn": ["^build", "build"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "clean": {
      "cache": false
    }
  }
}
