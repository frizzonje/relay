{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "lint": {},
    "test": {
      "dependsOn": ["^build"],
      // Тесты api ходят в настоящий Postgres. Turbo прячет от задач всё
      // окружение, кроме объявленного, — и без этой строки адрес базы до
      // vitest просто не доезжает, а суд по результату выглядит как «тесты
      // почему-то требуют базу, которой нет». Заодно адрес входит в хэш: с
      // другой базой результат прошлого прогона не считается.
      "env": ["TEST_DATABASE_URL"]
    },
    // Единственная задача, которая читает файлы за пределами своего пакета:
    // два теста shared проверяют то, чего не видит компилятор, — что каждое
    // событие панели слушает гейтвей api и что каждый параметр каталога
    // кто-то читает в api или web. Хэш задачи по умолчанию видит только сам
    // пакет, и правка в приложении оставляла бы в силе ЗЕЛЁНЫЙ результат из
    // кэша — так однажды и вышло (12d2141). Поэтому оба приложения во входах.
    "@relay/shared#test": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "../../apps/api/src/**",
        "../../apps/web/**/*.{ts,tsx}",
        "!../../apps/web/.next/**",
        "!../../apps/web/node_modules/**"
      ]
    },
    // tsconfig веба включает `.next/types/**/*.ts` — типы маршрутов, которые
    // пишет сам `next build`. То есть typecheck читает выход соседней задачи,
    // а объявлял зависимость только от `^build` (пакеты выше по графу). Своей
    // сборки среди них нет, так что turbo честно запускал обе разом — и на
    // чистой машине tsc падал с TS6053 на файлах, которых ещё не существует.
    // Локально этого не видно: `.next` остаётся с прошлого раза.
    "@relay/web#typecheck": {
      "dependsOn": ["^build", "build"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "clean": {
      "cache": false
    }
  }
}
